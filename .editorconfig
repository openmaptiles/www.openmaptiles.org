# Matches what the repo already does, so it documents the convention rather than
# changing it. See https://editorconfig.org — most editors honour this without a plugin.

root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown, so stripping them silently
# changes rendered output.
trim_trailing_whitespace = false

[*.{rb,yml,yaml,json,scss,js,html}]
indent_size = 2

[Gemfile]
indent_size = 2

[Makefile]
indent_style = tab

# Vendored, pre-built libraries: minified and reformatted by their own toolchains, and
# some carry no final newline. Leave them exactly as upstream shipped them so a diff
# against upstream stays readable — see THIRD-PARTY-NOTICES.md.
[{assets/js/vendor/**,inspect-tool/**}]
charset = unset
end_of_line = unset
insert_final_newline = false
trim_trailing_whitespace = false
indent_style = unset
indent_size = unset
